<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.smartmall</groupId>
        <artifactId>smart-mall</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>
    <artifactId>smartmall-security</artifactId>
    <name>smartmall-security</name>
    <description>smartmall-security</description>
    <dependencies>
        <!-- 依赖公共模块（Result、ResultCode、BusinessException 等） -->
        <dependency>
            <groupId>com.smartmall</groupId>
            <artifactId>smartmall-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 依赖用户模块（User实体、UserMapper，供UserDetailsServiceImpl加载用户） -->
        <dependency>
            <groupId>com.smartmall</groupId>
            <artifactId>smartmall-user</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Spring Security（SecurityConfig、JwtAuthenticationFilter 等依赖它） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>