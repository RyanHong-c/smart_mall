<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.4</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>com.smartmall</groupId>
    <artifactId>smart-mall</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>SmartMall</name>
    <description>SmartMall</description>
    <url/>
    <licenses>
        <license/>
    </licenses>
    <developers>
        <developer/>
    </developers>
    <modules>
        <module>smartmall-common</module>
        <module>smartmall-user</module>
        <module>smartmall-product</module>
        <module>smartmall-category</module>
        <module>smartmall-inventory</module>
        <module>smartmall-cart</module>
        <module>smartmall-order</module>
        <module>smartmall-auth</module>
        <module>smartmall-security</module>
        <module>smartmall-gateway</module>
        <module>smartmall-search</module>
        <module>smartmall-payment</module>
        <module>smartmall-address</module>
        <module>smartmall-agent</module>
    </modules>
    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>
    <properties>
        <java.version>17</java.version>
        <spring-cloud.version>2025.0.0</spring-cloud.version>
        <spring-cloud-alibaba.version>2023.0.3.2</spring-cloud-alibaba.version>
    </properties>

    <!-- ============================================ -->
    <!-- BOM（Bill of Materials）—— 版本清单              -->
    <!-- 不引入任何实际代码，只统一管理所有子模块的依赖版本    -->
    <!-- 子模块引入 Nacos/Feign 等依赖时不用写版本号        -->
    <!-- ============================================ -->
    <dependencyManagement>
        <dependencies>
            <!-- Spring Cloud BOM（Nacos、Feign、Gateway 等组件版本） -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Spring Cloud Alibaba BOM（Nacos、Sentinel、Seata 等版本） -->
            <dependency>
                <groupId>com.alibaba.cloud</groupId>
                <artifactId>spring-cloud-alibaba-dependencies</artifactId>
                <version>${spring-cloud-alibaba.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- ============================================ -->
        <!-- Spring Boot 核心启动器                         -->
        <!-- 包含 Spring 核心框架 + 自动配置 + 日志(logback) -->
        <!-- 几乎所有 Spring Boot 项目都必须引入            -->
        <!-- ============================================ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!-- ============================================ -->
        <!-- Web 开发启动器                                 -->
        <!-- 包含内嵌 Tomcat + Spring MVC                   -->
        <!-- 用于开发 REST 接口 / Controller，写后端接口必需  -->
        <!-- ============================================ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- ================= 数据库相关 ================= -->

        <!-- ============================================ -->
        <!-- MyBatis-Plus 启动器（Spring Boot 3 专用版）     -->
        <!-- 增强版 MyBatis，简化 CRUD，不用手写大量 SQL      -->
        <!-- 提供 save()、getById()、updateById() 等现成方法  -->
        <!-- ============================================ -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>3.5.12</version>
        </dependency>

        <!-- MyBatis-Plus 分页插件（3.5.9+ 需单独引入） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser-4.9</artifactId>
            <version>3.5.12</version>
        </dependency>

        <!-- ============================================ -->
        <!-- Druid 数据库连接池（Spring Boot 3 专用版）       -->
        <!-- 阿里巴巴出品，管理数据库连接，还自带监控页面       -->
        <!-- 比默认连接池(HikariCP)多了 SQL 监控、防SQL注入等功能 -->
        <!-- ============================================ -->
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>druid-spring-boot-3-starter</artifactId>
            <version>1.2.23</version>
        </dependency>

        <!-- ============================================ -->
        <!-- MySQL 数据库驱动                               -->
        <!-- 让 Java 程序能够连接、操作 MySQL 数据库          -->
        <!-- scope=runtime：只在运行时需要，编码阶段不需要     -->
        <!-- ============================================ -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ================= 缓存相关 ================= -->

        <!-- ============================================ -->
        <!-- Redis 启动器                                   -->
        <!-- 底层默认使用 Lettuce 客户端连接 Redis            -->
        <!-- 提供 RedisTemplate、RedisConnectionFactory 等   -->
        <!-- 当前用于：Product 详情缓存                      -->
        <!-- 接下来还会用于：JWT黑名单、验证码、购物车、分类树等 -->
        <!-- ============================================ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- ============================================ -->
        <!-- Redisson —— Redis 分布式框架                    -->
        <!-- 提供：分布式锁、布隆过滤器、原子操作等高级功能       -->
        <!-- 用于：缓存穿透防护（布隆过滤器）、库存扣减（分布式锁） -->
        <!-- ============================================ -->
        <dependency>
            <groupId>org.redisson</groupId>
            <artifactId>redisson-spring-boot-starter</artifactId>
            <version>3.40.2</version>
        </dependency>

        <!-- ================= 消息队列相关 ================= -->

        <!-- ============================================ -->
        <!-- RocketMQ 启动器                                -->
        <!-- Spring Cloud Alibaba 生态原生的消息中间件         -->
        <!-- 用于：异步下单解耦、库存变更通知、订单状态广播     -->
        <!-- ============================================ -->
        <dependency>
            <groupId>org.apache.rocketmq</groupId>
            <artifactId>rocketmq-spring-boot-starter</artifactId>
            <version>2.3.3</version>
        </dependency>

        <!-- ================= 认证授权相关 ================= -->

        <!-- ============================================ -->
        <!-- Spring Security 完整启动器                      -->
        <!-- 提供完整的认证授权体系：                          -->
        <!-- - 密码加密（BCryptPasswordEncoder）              -->
        <!-- - 请求过滤器链（FilterChain）                     -->
        <!-- - 认证管理器（AuthenticationManager）             -->
        <!-- - 方法级权限注解（@PreAuthorize 等）               -->
        <!-- ⚠️ 引入后默认会拦截所有接口要求登录，              -->
        <!-- 需要在 SecurityConfig 里显式放行登录/注册等接口     -->
        <!-- ⚠️ 已包含 spring-security-crypto 的全部功能，       -->
        <!-- 不需要再单独引入 spring-security-crypto            -->
        <!-- ⚠️ 已从父 POM 移除，改为按需在 security/user 模块引入 -->
        <!-- ============================================ -->

        <!-- ============================================ -->
        <!-- JJWT —— JWT（JSON Web Token）生成与解析库        -->
        <!-- 拆成三个包，分工如下：                            -->
        <!-- ============================================ -->

        <!-- jjwt-api：公共接口和注解，编码阶段需要（编译期依赖） -->
        <!-- 项目中 import io.jsonwebtoken.* 相关类都来自这里     -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.11.5</version>
        </dependency>

        <!-- jjwt-impl：JWT 具体实现逻辑（生成签名、校验签名等）   -->
        <!-- scope=runtime：写代码时不需要直接引用它的类，          -->
        <!-- 只在程序运行时由 jjwt-api 内部调用                    -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.11.5</version>
            <scope>runtime</scope>
        </dependency>

        <!-- jjwt-jackson：JWT 内容（Claims）与 JSON 互转所需，     -->
        <!-- 底层依赖 Jackson 做序列化/反序列化，运行时才需要        -->
        <!-- 如果不引入，生成/解析 Token 时会在运行时报错            -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.11.5</version>
            <scope>runtime</scope>
        </dependency>

        <!-- ================= 工具类相关 ================= -->

        <!-- ============================================ -->
        <!-- Lombok 工具库                                  -->
        <!-- 用注解自动生成 getter/setter/构造方法等模板代码   -->
        <!-- 例如 @Data、@RequiredArgsConstructor 就来自它    -->
        <!-- optional=true：不会传递给依赖你项目的其他模块      -->
        <!-- ⚠️ 需要 IDEA 装 Lombok 插件，否则代码报红看不懂     -->
        <!-- ============================================ -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ============================================ -->
        <!-- Hutool 工具类库（核心模块）                     -->
        <!-- 国产 Java 工具箱，提供字符串、日期、集合等常用工具  -->
        <!-- 例如代码里用到的 StrUtil.isNotBlank() 就来自它     -->
        <!-- ============================================ -->
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-core</artifactId>
            <version>5.8.20</version>
        </dependency>

        <!-- ============================================ -->
        <!-- 参数校验启动器                                 -->
        <!-- 提供 @NotNull、@NotBlank、@Email 等校验注解      -->
        <!-- 常用于校验前端传来的 DTO 参数是否合法             -->
        <!-- 例如：@NotBlank(message = "用户名不能为空")       -->
        <!-- ============================================ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- ================= 接口文档相关 ================= -->

        <!-- ============================================ -->
        <!-- Swagger UI / OpenAPI 接口文档生成               -->
        <!-- 自动扫描 Controller 生成可视化 API 文档页面        -->
        <!-- 访问地址通常是：/swagger-ui.html 或 /swagger-ui/index.html -->
        <!-- 方便前后端联调、接口测试，不用再手写文档            -->
        <!-- ⚠️ 引入 Spring Security 后，这个文档页面的路径      -->
        <!-- 也需要在 SecurityConfig 里放行，否则打不开           -->
        <!-- ============================================ -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.8.8</version>
        </dependency>

        <!-- ================= 测试相关 ================= -->

        <!-- ============================================ -->
        <!-- Spring Boot 测试启动器                         -->
        <!-- 包含 JUnit、Mockito 等测试相关依赖               -->
        <!-- scope=test：只在测试代码里能用，不会打进最终的包   -->
        <!-- ============================================ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- ================= 微服务相关 ================= -->

        <!-- ============================================ -->
        <!-- Nacos 服务注册与发现                            -->
        <!-- 服务启动时自动注册到 Nacos，其他服务通过服务名发现  -->
        <!-- 版本由 spring-cloud-alibaba-dependencies BOM 管理 -->
        <!-- ============================================ -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>

        <!-- ============================================ -->
        <!-- Nacos 配置中心                                 -->
        <!-- 统一管理所有微服务的配置，支持动态刷新              -->
        <!-- 版本由 spring-cloud-alibaba-dependencies BOM 管理 -->
        <!-- ============================================ -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
        </dependency>

        <!-- ============================================ -->
        <!-- Bootstrap 启动器（Spring Cloud 2020+ 需要显式引入） -->
        <!-- 让 Spring Cloud 能读取 bootstrap.yml/bootstrap.properties -->
        <!-- Nacos 配置中心需要用到它                         -->
        <!-- ============================================ -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-bootstrap</artifactId>
        </dependency>

        <!-- ============================================ -->
        <!-- Sentinel 流量控制 & 熔断降级                     -->
        <!-- 流量控制：限制 QPS，防止突发流量打垮服务           -->
        <!-- 熔断降级：Feign 调用失败时快速失败，避免雪崩       -->
        <!-- 版本由 spring-cloud-alibaba-dependencies BOM 管理 -->
        <!-- ============================================ -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-sentinel</artifactId>
        </dependency>

        <!-- ============================================ -->
        <!-- OpenFeign 声明式服务调用                        -->
        <!-- 把 Java 接口方法调用自动转换成 HTTP 请求          -->
        <!-- 版本由 spring-cloud-dependencies BOM 管理       -->
        <!-- ============================================ -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>

        <!-- ============================================ -->
        <!-- LoadBalancer 负载均衡器                        -->
        <!-- Feign 发 HTTP 请求时，通过服务名自动从 Nacos 获取 -->
        <!-- 实例列表，并做客户端负载均衡                      -->
        <!-- ============================================ -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>

        <!-- ============================================ -->
        <!-- Micrometer Tracing + Zipkin 链路追踪          -->
        <!-- 基于 Brave 实现，自动采集 HTTP/Feign/DB 调用链  -->
        <!-- 无需 javaagent，Spring Boot 3 原生集成         -->
        <!-- 版本由 spring-boot-dependencies BOM 管理       -->
        <!-- ============================================ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-brave</artifactId>
        </dependency>
        <dependency>
            <groupId>io.zipkin.reporter2</groupId>
            <artifactId>zipkin-reporter-brave</artifactId>
        </dependency>
        <dependency>
            <groupId>io.zipkin.reporter2</groupId>
            <artifactId>zipkin-sender-urlconnection</artifactId>
        </dependency>
        <!-- Feign 集成 Micrometer Tracing，自动传播 traceId 到下游服务 -->
        <dependency>
            <groupId>io.github.openfeign</groupId>
            <artifactId>feign-micrometer</artifactId>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!--
                    生成两个 JAR：
                    - smartmall-product-0.0.1-SNAPSHOT.jar（普通JAR，类在根目录，供其他模块依赖）
                    - smartmall-product-0.0.1-SNAPSHOT-exec.jar（fat JAR，BOOT-INF结构，供运行）
                    -->
                    <classifier>exec</classifier>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                    <!-- Zipkin 链路追踪通过 Micrometer Tracing 自动集成，无需 javaagent -->
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-compile</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                        <configuration>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>org.projectlombok</groupId>
                                    <artifactId>lombok</artifactId>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </execution>
                    <execution>
                        <id>default-testCompile</id>
                        <phase>test-compile</phase>
                        <goals>
                            <goal>testCompile</goal>
                        </goals>
                        <configuration>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>org.projectlombok</groupId>
                                    <artifactId>lombok</artifactId>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>